---

---

<section id="education" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My journey</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Education & Certifications</h3>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Education -->
      <div>
        <h4 class="text-xl font-semibold mb-6 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.1 2.7 2 6 2s6-.9 6-2v-5"/></svg>
          Education
        </h4>
        <div class="relative pl-6 border-l-2 border-[var(--white-icon-tr)]">
          <div class="relative pb-8">
            <div class="absolute -left-[1.6rem] top-1 w-3 h-3 rounded-full bg-[var(--sec)] ring-4 ring-[var(--background)]"></div>
            <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-xl p-5 hover:border-[var(--sec)] transition-all duration-300">
              <span class="text-[var(--sec)] text-xs font-semibold uppercase tracking-wider">2024 – 2028 (Expected)</span>
              <h5 class="text-lg font-semibold mt-2">Bachelor of Information Technology (BIT)</h5>
              <p class="text-[var(--white-icon)] text-sm mt-1">General Sir John Kotelawala Defence University (KDU)</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Certifications -->
      <div>
        <h4 class="text-xl font-semibold mb-6 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
          Certifications
        </h4>
        <div class="relative pl-6 border-l-2 border-[var(--white-icon-tr)] space-y-0">
          <!-- CCNA -->
          <div class="relative pb-8">
            <div class="absolute -left-[1.6rem] top-1 w-3 h-3 rounded-full bg-[var(--sec)] ring-4 ring-[var(--background)]"></div>
            <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-xl p-5 hover:border-[var(--sec)] transition-all duration-300">
              <span class="text-[var(--sec)] text-xs font-semibold uppercase tracking-wider">Nov 2025</span>
              <h5 class="text-lg font-semibold mt-2">CCNA: Introduction to Networks</h5>
              <p class="text-[var(--white-icon)] text-sm mt-1">Cisco Networking Academy / KDU</p>
              <a
                href="/certificates/ccna.pdf"
                target="_blank"
                class="inline-flex items-center gap-1 mt-3 text-xs text-[var(--sec)] hover:text-[var(--white)] transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                View Certificate
              </a>
            </div>
          </div>

          <!-- Python -->
          <div class="relative pb-8">
            <div class="absolute -left-[1.6rem] top-1 w-3 h-3 rounded-full bg-[var(--white-icon)] ring-4 ring-[var(--background)]"></div>
            <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-xl p-5 hover:border-[var(--sec)] transition-all duration-300">
              <span class="text-[var(--white-icon)] text-xs font-semibold uppercase tracking-wider">Apr 2022</span>
              <h5 class="text-lg font-semibold mt-2">Python for Beginners</h5>
              <p class="text-[var(--white-icon)] text-sm mt-1">Centre for Open & Distance Learning (CODL), University of Moratuwa</p>
              <a
                href="/certificates/Python_for_Beginners_E-Certificate.pdf"
                target="_blank"
                class="inline-flex items-center gap-1 mt-3 text-xs text-[var(--sec)] hover:text-[var(--white)] transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                View Verification
              </a>
            </div>
          </div>

          <!-- Web Design -->
          <div class="relative pb-8">
            <div class="absolute -left-[1.6rem] top-1 w-3 h-3 rounded-full bg-[var(--white-icon)] ring-4 ring-[var(--background)]"></div>
            <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-xl p-5 hover:border-[var(--sec)] transition-all duration-300">
              <span class="text-[var(--white-icon)] text-xs font-semibold uppercase tracking-wider">Jun 2022</span>
              <h5 class="text-lg font-semibold mt-2">Web Design for Beginners</h5>
              <p class="text-[var(--white-icon)] text-sm mt-1">Centre for Open & Distance Learning (CODL), University of Moratuwa</p>
              <a
                href="/certificates/Web_Design_for_Beginners_E-Certificate.pdf"
                target="_blank"
                class="inline-flex items-center gap-1 mt-3 text-xs text-[var(--sec)] hover:text-[var(--white)] transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                View Certificate
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
